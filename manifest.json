{
  "manifest_version": 3,
  "name": "Kurssikaveri",
  "version": "0.8.3",
  "description": "Järjestää Moodlesta ladatut opiskelumateriaalit kurssikansioihin oikeilla nimillä.",
  "permissions": [
    "downloads",
    "downloads.open",
    "storage",
    "notifications",
    "tabs",
    "webRequest",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://moodle5.samk.fi/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle5.samk.fi/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/kurssikaveri-merkki-vihrea.svg",
        "icons/kurssikaveri-merkki-valkoinen.svg",
        "shared/skins.js",
        "shared/barState.js"
      ],
      "matches": [
        "https://moodle5.samk.fi/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kurssikaveri",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "library.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
